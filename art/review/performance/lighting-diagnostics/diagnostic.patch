+// Temporary ablation fixture; compiled only into the isolated diagnostic preview.
+fn diagnose_lighting(
+    mut commands: Commands,
+    keys: Res<ButtonInput<KeyCode>>,
+    spots: Query<(Entity, &SpotLight)>,
+    suns: Query<(Entity, &DirectionalLight)>,
+    cameras: Query<(Entity, Option<&DistanceFog>), With<Camera3d>>,
+    meshes: Query<Entity, With<Mesh3d>>,
+    mut original_spots: Local<Vec<(Entity, SpotLight)>>,
+    mut original_suns: Local<Vec<(Entity, DirectionalLight)>>,
+    mut original_fog: Local<Option<DistanceFog>>,
+    mut shadow_map: ResMut<bevy::light::DirectionalLightShadowMap>,
+) {
+    if original_spots.is_empty() {
+        *original_spots = spots.iter().map(|(e, l)| (e, l.clone())).collect();
+        *original_suns = suns.iter().map(|(e, l)| (e, l.clone())).collect();
+        *original_fog = cameras.iter().find_map(|(_, f)| f.cloned());
+    }
+    let Some(mode) = [KeyCode::Digit0, KeyCode::Digit1, KeyCode::Digit2,
+        KeyCode::Digit3, KeyCode::Digit4, KeyCode::Digit5, KeyCode::Digit6,
+        KeyCode::Digit7, KeyCode::Digit8, KeyCode::Digit9, KeyCode::Minus, KeyCode::Equal]
+        .iter().position(|k| keys.just_pressed(*k)) else { return };
+    assert_eq!(original_spots.len(), 6);
+    assert_eq!(original_suns.len(), 1);
+    for (e, original) in original_spots.iter() {
+        if mode == 5 || mode == 7 { commands.entity(*e).remove::<SpotLight>(); }
+        else {
+            let mut light = original.clone();
+            light.shadow_maps_enabled = mode != 2 && mode != 4;
+            commands.entity(*e).insert(light);
+        }
+    }
+    for (e, original) in original_suns.iter() {
+        if mode == 6 || mode == 7 { commands.entity(*e).remove::<DirectionalLight>(); }
+        else {
+            let mut light = original.clone();
+            light.shadow_maps_enabled = mode != 3 && mode != 4;
+            commands.entity(*e).insert(light);
+        }
+    }
+    for (e, _) in &cameras {
+        if mode == 1 { commands.entity(e).remove::<DistanceFog>(); }
+        else { commands.entity(e).insert(original_fog.as_ref().unwrap().clone()); }
+        commands.entity(e).insert(if mode == 8 {
+            bevy::light::ShadowFilteringMethod::Hardware2x2
+        } else { bevy::light::ShadowFilteringMethod::Gaussian });
+    }
+    for e in &meshes {
+        commands.entity(e).remove::<(bevy::light::NotShadowReceiver, bevy::light::NotShadowCaster)>();
+        if mode == 10 { commands.entity(e).insert(bevy::light::NotShadowReceiver); }
+        if mode == 11 { commands.entity(e).insert(bevy::light::NotShadowCaster); }
+    }
+    shadow_map.size = if mode == 9 { 1024 } else { 2048 };
+    info!("LIGHT_ABLATION mode={mode}");
+}
